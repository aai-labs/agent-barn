<mjml>
  <mj-head>
    <mj-title>Password Reset Request</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <mj-style>
      .body {
        background-color: #f3f4f6;
      }
      .card {
        border-radius: 12px;
        background-color: #ffffff;
      }
      .button a {
        text-decoration: none !important;
        color: #ffffff !important;
      }
      .footer-text a {
        color: #007bff;
        text-decoration: none;
      }
      .footer-text a:hover {
        text-decoration: underline;
      }
      .company-name-logo a {
        text-decoration: none;
        color: #1f2937;
      }
    </mj-style>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#374151" />
      <mj-button background-color="#007bff" color="#ffffff" font-size="16px" font-weight="500" border-radius="8px" inner-padding="12px 24px" />
      <mj-section padding="20px 0" />
      <mj-column padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body css-class="body">
    <mj-section padding-top="40px" padding-bottom="20px">
      <mj-column width="100%">
        <mj-text
          font-size="28px"
          font-weight="700"
          color="#1f2937"
          align="center"
          letter-spacing="-0.5px"
          line-height="1.2"
          css-class="company-name-logo"
          padding="0"
        >
          Export Discovery
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 20px">
      <mj-column css-class="card">
        <mj-text
          font-size="24px"
          font-weight="600"
          color="#1f2937"
          align="center"
          padding="30px 25px 15px 25px"
        >
          Reset Your Password
        </mj-text>

        <mj-text
          align="left"
          padding="10px 25px"
        >
          Hi {{ user_name }},
        </mj-text>
        <mj-text
          align="left"
          padding="5px 25px 15px 25px"
        >
          We received a request to reset the password for your account associated with this email address. If you made this request, please click the button below to set a new password.
        </mj-text>

        <mj-button
          href="{{ password_reset_link }}" align="center"
          css-class="button"
          padding="15px 25px"
        >
          Reset Password
        </mj-button>

        <mj-text
          align="center"
          font-size="14px"
          color="#6b7280"
          padding="15px 25px 5px 25px"
        >
          If the button above doesn't work, copy and paste this link into your browser:
        </mj-text>
        <mj-text
          align="center"
          font-size="14px"
          color="#007bff"
          padding="0px 25px 20px 25px"
        >
          <a href="{{ password_reset_link }}" style="color: #007bff; text-decoration: none;">{{ password_reset_link }}</a> </mj-text>

        <mj-divider border-color="#e5e7eb" border-width="1px" padding="0 25px" />

        <mj-text
          align="left"
          font-size="14px"
          color="#6b7280"
          padding="20px 25px 30px 25px"
        >
          If you did not request a password reset, please ignore this email or contact our support team if you have any concerns.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="30px 20px 40px 20px">
      <mj-column width="100%">
        <mj-text
          align="center"
          font-size="12px"
          color="#6b7280"
          css-class="footer-text"
          line-height="1.5"
        >
          &copy; {{ current_year }} Export discovery. All rights reserved
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

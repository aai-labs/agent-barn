<mjml>
  <mj-head>
    <mj-title>You're invited to Agent Barn</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <mj-style>
      .body {
        background-color: #f4f2ee;
      }
      .card {
        border-radius: 12px;
        background-color: #ffffff;
        border: 1px solid #e7e4dc;
      }
      .button a {
        text-decoration: none !important;
        color: #fbfaf8 !important;
      }
      .link-text a {
        color: #4338ca;
        text-decoration: none;
        word-break: break-all;
      }
      .footer-text a {
        color: #6a655c;
        text-decoration: none;
      }
      .footer-text a:hover {
        text-decoration: underline;
      }
    </mj-style>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#36322c" />
      <mj-button background-color="#1a1815" color="#fbfaf8" font-size="16px" font-weight="600" border-radius="10px" inner-padding="13px 26px" />
      <mj-section padding="20px 0" />
      <mj-column padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body css-class="body">
    <mj-section padding-top="40px" padding-bottom="12px">
      <mj-column width="100%">
        <mj-raw>
          <div style="text-align:center;">
            <img src="cid:agent-barn-logo" width="56" height="56" alt="Agent Barn" style="display:inline-block;width:56px;height:56px;border:0;outline:none;text-decoration:none;" />
          </div>
        </mj-raw>
        <mj-text
          font-size="24px"
          font-weight="700"
          color="#1a1815"
          align="center"
          letter-spacing="-0.4px"
          line-height="1.2"
          padding="12px 0 0 0"
        >
          Agent Barn
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 20px">
      <mj-column css-class="card">
        <mj-text
          font-size="22px"
          font-weight="600"
          color="#1a1815"
          align="center"
          padding="32px 28px 14px 28px"
        >
          You're invited
        </mj-text>

        <mj-text align="left" padding="8px 28px">
          Hi {{ user_name }},
        </mj-text>
        <mj-text align="left" padding="4px 28px 18px 28px">
          You've been invited to join Agent Barn. To get started, click the button below to set your password and access your workspace.
        </mj-text>

        <mj-button
          href="{{ set_password_link }}"
          align="center"
          css-class="button"
          padding="6px 28px 18px 28px"
        >
          Set your password
        </mj-button>

        <mj-text
          align="center"
          font-size="14px"
          color="#6a655c"
          padding="8px 28px 4px 28px"
        >
          If the button doesn't work, copy and paste this link into your browser:
        </mj-text>
        <mj-text
          align="center"
          font-size="14px"
          css-class="link-text"
          padding="0 28px 22px 28px"
        >
          <a href="{{ set_password_link }}">{{ set_password_link }}</a>
        </mj-text>

        <mj-divider border-color="#e7e4dc" border-width="1px" padding="0 28px" />

        <mj-text
          align="left"
          font-size="14px"
          color="#97928a"
          padding="20px 28px 30px 28px"
        >
          If you weren't expecting this invitation, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="26px 20px 40px 20px">
      <mj-column width="100%">
        <mj-text
          align="center"
          font-size="12px"
          color="#97928a"
          css-class="footer-text"
          line-height="1.5"
        >
          &copy; {{ current_year }} Agent Barn. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

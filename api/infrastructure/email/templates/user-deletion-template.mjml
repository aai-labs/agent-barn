<mjml>
  <mj-head>
    <mj-title>Your Agent Barn account has been deleted</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <mj-style>
      .body {
        background-color: #f4f2ee;
      }
      .card {
        border-radius: 12px;
        background-color: #ffffff;
        border: 1px solid #e7e4dc;
      }
      .footer-text a {
        color: #6a655c;
        text-decoration: none;
      }
      .footer-text a:hover {
        text-decoration: underline;
      }
    </mj-style>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#36322c" />
      <mj-section padding="20px 0" />
      <mj-column padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body css-class="body">
    <mj-section padding-top="40px" padding-bottom="12px">
      <mj-column width="100%">
        <mj-raw>
          <div style="text-align:center;">
            <img src="cid:agent-barn-logo" width="56" height="56" alt="Agent Barn" style="display:inline-block;width:56px;height:56px;border:0;outline:none;text-decoration:none;" />
          </div>
        </mj-raw>
        <mj-text
          font-size="24px"
          font-weight="700"
          color="#1a1815"
          align="center"
          letter-spacing="-0.4px"
          line-height="1.2"
          padding="12px 0 0 0"
        >
          Agent Barn
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 20px">
      <mj-column css-class="card">
        <mj-text
          font-size="22px"
          font-weight="600"
          color="#1a1815"
          align="center"
          padding="32px 28px 14px 28px"
        >
          Your account has been deleted
        </mj-text>

        <mj-text align="left" padding="8px 28px">
          Hi {{ user_name }},
        </mj-text>
        <mj-text align="left" padding="4px 28px 14px 28px">
          Your Agent Barn account has been permanently deleted.
        </mj-text>
        <mj-text align="left" padding="0 28px 18px 28px">
          If you didn't request this deletion or believe this was a mistake, please contact our support team immediately.
        </mj-text>

        <mj-divider border-color="#e7e4dc" border-width="1px" padding="0 28px" />

        <mj-text
          align="left"
          font-size="14px"
          color="#97928a"
          padding="20px 28px 30px 28px"
        >
          We're sorry to see you go. You can create a new account anytime.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="26px 20px 40px 20px">
      <mj-column width="100%">
        <mj-text
          align="center"
          font-size="12px"
          color="#97928a"
          css-class="footer-text"
          line-height="1.5"
        >
          &copy; {{ current_year }} Agent Barn. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
